{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    // The 1.13.1 `starhermit types` declarations fail tsc by themselves
    // (AntialiasMode used in starhermit:engine, declared in starhermit:scene;
    // fixed upstream, unreleased).
    "skipLibCheck": true
  },
  "files": [".starhermit/starhermit.d.ts", "src/main.ts"]
}
